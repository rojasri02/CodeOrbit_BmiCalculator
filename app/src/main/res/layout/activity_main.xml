<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_gradient"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- HEADER SECTION -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="195dp"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <!-- LEFT SIDE TEXT -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="BMI"
                    android:textColor="#751044"
                    android:textSize="39sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Calculator"
                    android:textColor="#751044"
                    android:textSize="27sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:text="Be Healthy,\nBe Happy ♡"
                    android:textColor="#71334F"
                    android:textSize="16sp"
                    android:textStyle="italic"
                    android:lineSpacingExtra="3dp" />

            </LinearLayout>

            <!-- FITNESS GIRL IMAGE -->
            <ImageView
                android:layout_width="175dp"
                android:layout_height="190dp"
                android:layout_marginStart="-3dp"
                android:src="@drawable/fitness_girl"
                android:scaleType="fitCenter"
                android:contentDescription="Fitness Girl" />

        </LinearLayout>

        <!-- MAIN WHITE CARD -->

        <!-- HEALTH TAGLINE -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/card_bg"
            android:orientation="vertical"
            android:padding="20dp">

            <!-- GENDER -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Gender"
                android:textColor="#54243D"
                android:textSize="16sp"
                android:textStyle="bold" />

            <RadioGroup
                android:id="@+id/genderGroup"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:layout_marginBottom="20dp"
                android:orientation="horizontal">

                <RadioButton
                    android:id="@+id/maleRadio"
                    android:layout_width="0dp"
                    android:layout_height="65dp"
                    android:layout_marginEnd="8dp"
                    android:layout_weight="1"
                    android:background="@drawable/male_card"
                    android:button="@null"
                    android:checked="true"
                    android:gravity="center"
                    android:text="👨 Male"
                    android:textColor="#225D9C"
                    android:textSize="17sp"
                    android:textStyle="bold" />

                <RadioButton
                    android:id="@+id/femaleRadio"
                    android:layout_width="0dp"
                    android:layout_height="65dp"
                    android:layout_marginStart="8dp"
                    android:layout_weight="1"
                    android:background="@drawable/female_card"
                    android:button="@null"
                    android:gravity="center"
                    android:text="👩 Female"
                    android:textColor="#B52D73"
                    android:textSize="17sp"
                    android:textStyle="bold" />

            </RadioGroup>

            <!-- HEIGHT -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="📏  Height (cm)"
                android:textColor="#54243D"
                android:textSize="15sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/heightInput"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="6dp"
                android:layout_marginBottom="15dp"
                android:background="@drawable/input_bg"
                android:hint="Enter height in cm"
                android:inputType="numberDecimal"
                android:padding="12dp"
                android:textColor="#54243D"
                android:textColorHint="#A47B91" />

            <!-- WEIGHT -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="⚖️  Weight (kg)"
                android:textColor="#54243D"
                android:textSize="15sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/weightInput"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="6dp"
                android:layout_marginBottom="15dp"
                android:background="@drawable/input_bg"
                android:hint="Enter weight in kg"
                android:inputType="numberDecimal"
                android:padding="12dp"
                android:textColor="#54243D"
                android:textColorHint="#A47B91" />

            <!-- AGE -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🎂  Age (years)"
                android:textColor="#54243D"
                android:textSize="15sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/ageInput"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="6dp"
                android:layout_marginBottom="22dp"
                android:background="@drawable/input_bg"
                android:hint="Enter your age"
                android:inputType="number"
                android:padding="12dp"
                android:textColor="#54243D"
                android:textColorHint="#A47B91" />

            <!-- CALCULATE BMI BUTTON -->
            <Button
                android:id="@+id/calculateButton"
                android:layout_width="match_parent"
                android:layout_height="55dp"
                android:background="@drawable/button_pink"
                android:text="Calculate BMI  ➜"
                android:textColor="#FFFFFF"
                android:textSize="17sp"
                android:textStyle="bold" />

        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:layout_marginTop="18dp"
            android:layout_marginBottom="15dp"
            android:text="♡ Your Health Matters ♡\nSmall Steps, Healthier Life!"
            android:textColor="#751044"
            android:textSize="15sp"
            android:textStyle="bold"
            android:lineSpacingExtra="5dp" />

    </LinearLayout>

</ScrollView>
